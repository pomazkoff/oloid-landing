# Зеркало на российском хостинге (Apache). На Vercel этот файл не используется.

RewriteEngine On

# Только https
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# www уводим на основной адрес
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Единственная страница: всё несуществующее отдаём на главную,
# кроме архива старой версии и реальных файлов
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/ttf                  "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 7 days"
  ExpiresByType image/png                 "access plus 7 days"
  ExpiresByType image/webp                "access plus 7 days"
  ExpiresByType audio/mpeg                "access plus 7 days"
  ExpiresByType video/mp4                 "access plus 7 days"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(ttf|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
